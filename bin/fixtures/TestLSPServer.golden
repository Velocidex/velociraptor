
Test Case 1 Initialize call:
{
    "jsonrpc": "2.0",
    "id" : 1,
    "method": "initialize",
    "params": {}
}

{
 "jsonrpc": "2.0",
 "id": 1,
 "result": {
  "capabilities": {
   "textDocumentSync": 1,
   "completionProvider": {
    "triggerCharacters": [
     ".",
     "(",
     "?"
    ]
   },
   "hoverProvider": true,
   "documentSymbolProvider": true,
   "semanticTokensProvider": {
    "legend": {
     "tokenTypes": [
      "keyword",
      "comment",
      "string",
      "number",
      "operator",
      "function",
      "plugin",
      "variable",
      "property"
     ],
     "tokenModifiers": []
    },
    "full": true
   },
   "diagnosticProvider": {
    "identifier": "vql",
    "interFileDependencies": false,
    "workspaceDiagnostics": false
   }
  },
  "serverInfo": {
   "name": "vql-lsp",
   "version": "0.1"
  }
 }
}

Test Case 2 Add doc:
{
    "jsonrpc": "2.0",
    "id" : 2,
    "method": "textDocument/didOpen",
    "params": {
        "textDocument": {
           "uri": "file://XXXX",
           "text": "SELECT * FROM infoXXX()"
        }
    }
}

{
 "jsonrpc": "2.0",
 "method": "textDocument/publishDiagnostics",
 "params": {
  "uri": "file://xxxx/",
  "diagnostics": [
   {
    "range": {
     "start": {
      "line": 0,
      "character": 14
     },
     "end": {
      "line": 0,
      "character": 23
     }
    },
    "severity": 1,
    "source": "vql",
    "message": "(1,15) unknown_plugin: Unknown plugin infoXXX()"
   }
  ]
 }
}
{
 "jsonrpc": "2.0",
 "id": 2,
 "result": null
}
